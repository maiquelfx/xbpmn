<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.12.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Solicitante" name="Solicitante" processRef="Process_Solicitante" />
    <bpmn:participant id="Participant_Comprador" name="Comprador" processRef="Process_Comprador" />
    <bpmn:participant id="Participant_Financeiro" name="Financeiro" processRef="Process_Financeiro" />
    <bpmn:messageFlow id="MessageFlow_Pedido" name="Enviar Pedido" sourceRef="Activity_CriarPedido" targetRef="StartEvent_Comprador" />
    <bpmn:messageFlow id="MessageFlow_Revisao" name="Solicitar Revisão" sourceRef="Activity_AjustarPedido" targetRef="Activity_CotarFornecedores" />
    <bpmn:messageFlow id="MessageFlow_Aprovado" name="Enviar para Pagamento" sourceRef="Activity_AprovarCotacao" targetRef="StartEvent_Financeiro" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Solicitante" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Solicitante" name="Necessidade de Compra Identificada">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_CriarPedido" name="Elaborar Pedido de Compra">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_RevisarNovamente</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Revisao" name="Pedido Aprovado?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Rejeitado</bpmn:outgoing>
      <bpmn:outgoing>Flow_AprovadoFim</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_AjustarPedido" name="Ajustar Pedido de Compra">
      <bpmn:incoming>Flow_Rejeitado</bpmn:incoming>
      <bpmn:outgoing>Flow_RevisarNovamente</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Solicitante" name="Processo Concluído com Sucesso">
      <bpmn:incoming>Flow_AprovadoFim</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Solicitante" targetRef="Activity_CriarPedido" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_CriarPedido" targetRef="Activity_ReceberRetorno" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_ReceberRetorno" targetRef="Gateway_Revisao" />
    <bpmn:sequenceFlow id="Flow_Rejeitado" name="Não" sourceRef="Gateway_Revisao" targetRef="Activity_AjustarPedido">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == 'rejeitado'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RevisarNovamente" sourceRef="Activity_AjustarPedido" targetRef="Activity_CriarPedido" />
    <bpmn:sequenceFlow id="Flow_AprovadoFim" name="Sim" sourceRef="Gateway_Revisao" targetRef="EndEvent_Solicitante">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == 'aprovado'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:intermediateCatchEvent id="Activity_ReceberRetorno" name="Aguardar Avaliação">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:intermediateCatchEvent>
  </bpmn:process>
  <bpmn:process id="Process_Comprador" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Comprador" name="Pedido Recebido">
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_2" />
    </bpmn:startEvent>
    <bpmn:task id="Activity_CotarFornecedores" name="Cotar com Fornecedores">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="TimerEvent_PrazoCota" name="Prazo de Cotação Expirado" attachedToRef="Activity_CotarFornecedores">
      <bpmn:outgoing>Flow_PrazoEstourado</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1" />
    </bpmn:boundaryEvent>
    <bpmn:task id="Activity_AjustarCotacao" name="Rever Fornecedores Alternativos">
      <bpmn:incoming>Flow_PrazoEstourado</bpmn:incoming>
      <bpmn:outgoing>Flow_RetomarCotacao</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AvaliarCotacao" name="Melhor Cotação Aceitável?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_RetomarCotacao</bpmn:incoming>
      <bpmn:outgoing>Flow_CotacaoReprovada</bpmn:outgoing>
      <bpmn:outgoing>Flow_CotacaoAprovada</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_SolicitarRevisao" name="Solicitar Revisão ao Solicitante">
      <bpmn:incoming>Flow_CotacaoReprovada</bpmn:incoming>
      <bpmn:outgoing>Flow_FimCompradorRejeita</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_AprovarCotacao" name="Aprovar Cotação e Enviar para Pagamento">
      <bpmn:incoming>Flow_CotacaoAprovada</bpmn:incoming>
      <bpmn:outgoing>Flow_FimCompradorAprova</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_CompradorRejeitado" name="Pedido Retornado para Ajustes">
      <bpmn:incoming>Flow_FimCompradorRejeita</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_CompradorAprovado" name="Processo no Comprador Finalizado">
      <bpmn:incoming>Flow_FimCompradorAprova</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="StartEvent_Comprador" targetRef="Activity_CotarFornecedores" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_CotarFornecedores" targetRef="Gateway_AvaliarCotacao" />
    <bpmn:sequenceFlow id="Flow_PrazoEstourado" sourceRef="TimerEvent_PrazoCota" targetRef="Activity_AjustarCotacao" />
    <bpmn:sequenceFlow id="Flow_RetomarCotacao" sourceRef="Activity_AjustarCotacao" targetRef="Gateway_AvaliarCotacao" />
    <bpmn:sequenceFlow id="Flow_CotacaoReprovada" name="Não" sourceRef="Gateway_AvaliarCotacao" targetRef="Activity_SolicitarRevisao">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${cotacaoValida == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CotacaoAprovada" name="Sim" sourceRef="Gateway_AvaliarCotacao" targetRef="Activity_AprovarCotacao">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${cotacaoValida == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FimCompradorRejeita" sourceRef="Activity_SolicitarRevisao" targetRef="EndEvent_CompradorRejeitado" />
    <bpmn:sequenceFlow id="Flow_FimCompradorAprova" sourceRef="Activity_AprovarCotacao" targetRef="EndEvent_CompradorAprovado" />
  </bpmn:process>
  <bpmn:process id="Process_Financeiro" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Financeiro" name="Dados de Pagamento Recebidos">
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_3" />
    </bpmn:startEvent>
    <bpmn:task id="Activity_EfetuarPagamento" name="Efetuar o Pagamento ao Fornecedor">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Financeiro" name="Pagamento Efetuado e Processo Encerrado">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="StartEvent_Financeiro" targetRef="Activity_EfetuarPagamento" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_EfetuarPagamento" targetRef="EndEvent_Financeiro" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Solicitante_di" bpmnElement="Participant_Solicitante" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1150" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Comprador_di" bpmnElement="Participant_Comprador" isHorizontal="true">
        <dc:Bounds x="160" y="360" width="1150" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Financeiro_di" bpmnElement="Participant_Financeiro" isHorizontal="true">
        <dc:Bounds x="160" y="690" width="1150" height="200" />
      </bpmndi:BPMNShape>
