<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DC/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DI/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Viagem"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="4.8.1">
  <bpmn:collaboration id="Collaboration_Viagem">
    <bpmn:participant id="Participant_Empresa" name="Processo de Solicitação de Viagem" processRef="Process_Viagem" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Viagem" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Viagem">
      <bpmn:lane id="Lane_Colaborador" name="Colaborador">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_SolicitarViagem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RevisarSolicitacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ReceberConfirmacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Gestor" name="Gestor">
        <bpmn:flowNodeRef>Activity_AvaliarSolicitacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Aprovacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TimerEvent_PrazoGestor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agencia" name="Agência de Viagens">
        <bpmn:flowNodeRef>Activity_ReservarPassagem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ReservarHotel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinReserva</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <bpmn:startEvent id="StartEvent_1" name="Necessidade de Viagem Identificada">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:userTask id="Activity_SolicitarViagem" name="Solicitar Viagem">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_Reenvio</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:userTask id="Activity_AvaliarSolicitacao" name="Avaliar Solicitação de Viagem">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:boundaryEvent id="TimerEvent_PrazoGestor" name="Prazo de 48h Expirado" cancelActivity="true" attachedToRef="Activity_AvaliarSolicitacao">
      <bpmn:outgoing>Flow_PrazoEstourado</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    
    <bpmn:exclusiveGateway id="Gateway_Aprovacao" name="Aprovado?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_PrazoEstourado</bpmn:incoming>
      <bpmn:outgoing>Flow_Aprovado</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejeitado</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:userTask id="Activity_RevisarSolicitacao" name="Revisar e Reenviar Solicitação">
      <bpmn:incoming>Flow_Rejeitado</bpmn:incoming>
      <bpmn:outgoing>Flow_Reenvio</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:serviceTask id="Activity_ReservarPassagem" name="Reservar Passagem Aérea">
      <bpmn:incoming>Flow_Aprovado</bpmn:incoming>
      <bpmn:outgoing>Flow_PassagemOK</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:serviceTask id="Activity_ReservarHotel" name="Reservar Hotel">
      <bpmn:incoming>Flow_Aprovado</bpmn:incoming>
      <bpmn:outgoing>Flow_HotelOK</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:parallelGateway id="Gateway_JoinReserva" name="Reservas Concluídas">
      <bpmn:incoming>Flow_PassagemOK</bpmn:incoming>
      <bpmn:incoming>Flow_HotelOK</bpmn:incoming>
      <bpmn:outgoing>Flow_ReservasProntas</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <bpmn:userTask id="Activity_ReceberConfirmacao" name="Receber Confirmação de Viagem">
      <bpmn:incoming>Flow_ReservasProntas</bpmn:incoming>
      <bpmn:outgoing>Flow_Fim</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:endEvent id="EndEvent_1" name="Processo Concluído">
      <bpmn:incoming>Flow_Fim</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_SolicitarViagem" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_SolicitarViagem" targetRef="Activity_AvaliarSolicitacao" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_AvaliarSolicitacao" targetRef="Gateway_Aprovacao" />
    <bpmn:sequenceFlow id="Flow_PrazoEstourado" sourceRef="TimerEvent_PrazoGestor" targetRef="Gateway_Aprovacao" />
    <bpmn:sequenceFlow id="Flow_Aprovado" name="Sim" sourceRef="Gateway_Aprovacao" targetRef="Activity_ReservarPassagem">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${aprovado == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PassagemOK" sourceRef="Activity_ReservarPassagem" targetRef="Gateway_JoinReserva" />
    <bpmn:sequenceFlow id="Flow_HotelOK" sourceRef="Activity_ReservarHotel" targetRef="Gateway_JoinReserva" />
    <bpmn:sequenceFlow id="Flow_ReservasProntas" sourceRef="Gateway_JoinReserva" targetRef="Activity_ReceberConfirmacao" />
    <bpmn:sequenceFlow id="Flow_Fim" sourceRef="Activity_ReceberConfirmacao" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_Rejeitado" name="Não" sourceRef="Gateway_Aprovacao" targetRef="Activity_RevisarSolicitacao">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${aprovado == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reenvio" sourceRef="Activity_RevisarSolicitacao" targetRef="Activity_SolicitarViagem" />
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Viagem">
      <bpmndi:BPMNShape id="Participant_Empresa_di" bpmnElement="Participant_Empresa" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1170" height="520" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Lane_Colaborador_di" bpmnElement="Lane_Colaborador" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1140" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Gestor_di" bpmnElement="Lane_Gestor" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="1140" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Agencia_di" bpmnElement="Lane_Agencia" isHorizontal="true">
        <dc:Bounds x="190" y="420" width="1140" height="180" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="242" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="221" y="185" width="79" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Activity_SolicitarViagem_di" bpmnElement="Activity_SolicitarViagem">
        <dc:Bounds x="320" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Activity_AvaliarSolicitacao_di" bpmnElement="Activity_AvaliarSolicitacao">
        <dc:Bounds x="320" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="TimerEvent_PrazoGestor_di" bpmnElement="TimerEvent_PrazoGestor">
        <dc:Bounds x="352" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="339" y="405" width="63" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Gateway_Aprovacao_di" bpmnElement="Gateway_Aprovacao" isMarkerVisible="true">
        <dc:Bounds x="475" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="474" y="291" width="53" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Activity_RevisarSolicitacao_di" bpmnElement="Activity_RevisarSolicitacao">
        <dc:Bounds x="450" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Activity_ReservarPassagem_di" bpmnElement="Activity_ReservarPassagem">
        <dc:Bounds x="620" y="440" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Activity_ReservarHotel_di" bpmnElement="Activity_ReservarHotel">
        <dc:Bounds x="620" y="530" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Gateway_JoinReserva_di" bpmnElement="Gateway_JoinReserva">
        <dc:Bounds x="785" y="485" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="781" y="542" width="59" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Activity_ReceberConfirmacao_di" bpmnElement="Activity_ReceberConfirmacao">
        <dc:Bounds x="890" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1042" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1031" y="185" width="59" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="278" y="160" />
        <di:waypoint x="320" y="160" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="370" y="200" />
        <di:waypoint x="370" y="300" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="420" y="340" />
        <di:waypoint x="475" y="340" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_PrazoEstourado_di" bpmnElement="Flow_PrazoEstourado">
        <di:waypoint x="370" y="398" />
        <di:waypoint x="370" y="420" />
        <di:waypoint x="500" y="420" />
        <di:waypoint x="500" y="365" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_Aprovado_di" bpmnElement="Flow_Aprovado">
        <di:waypoint x="525" y="340" />
        <di:waypoint x="570" y="340" />
        <di:waypoint x="570" y="480" />
        <di:waypoint x="620" y="480" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="576" y="322" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_PassagemOK_di" bpmnElement="Flow_PassagemOK">
        <di:waypoint x="720" y="480" />
        <di:waypoint x="753" y="480" />
        <di:waypoint x="753" y="510" />
        <di:waypoint x="785" y="510" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_HotelOK_di" bpmnElement="Flow_HotelOK">
        <di:waypoint x="720" y="570" />
        <di:waypoint x="753" y="570" />
        <di:waypoint x="753" y="510" />
        <di:waypoint x="785" y="510" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_ReservasProntas_di" bpmnElement="Flow_ReservasProntas">
        <di:waypoint x="835" y="510" />
        <di:waypoint x="863" y="510" />
        <di:waypoint x="863" y="160" />
        <di:waypoint x="890" y="160" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_Fim_di" bpmnElement="Flow_Fim">
        <di:waypoint x="990" y="160" />
        <di:waypoint x="1042" y="160" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_Rejeitado_di" bpmnElement="Flow_Rejeitado">
        <di:waypoint x="500" y="315" />
        <di:waypoint x="500" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="505" y="253" width="21" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_Reenvio_di" bpmnElement="Flow_Reenvio">
        <di:waypoint x="450" y="160" />
        <di:waypoint x="420" y="160" />
      </bpmndi:BPMNEdge>
      
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>