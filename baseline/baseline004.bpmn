<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Hotel" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.8.1">
  <bpmn:collaboration id="Collaboration_Hotel">
    <bpmn:participant id="Participant_Guest" name="Hóspede" processRef="Process_Guest" />
    <bpmn:participant id="Participant_Reception" name="Recepção" processRef="Process_Reception" />
    <bpmn:participant id="Participant_Cleaning" name="Equipe de Limpeza" processRef="Process_Cleaning" />
    <bpmn:messageFlow id="Flow_ReqReserva" sourceRef="Activity_SolicitarReserva" targetRef:Event_ReceberSolicitacao" />
    <bpmn:messageFlow id="Flow_SemQuarto" sourceRef:Activity_InformarSemQuarto" targetRef:Event_ReceberNegativa" />
    <bpmn:messageFlow id="Flow_ComQuarto" sourceRef:Activity_ConfirmarReserva" targetRef:Event_ReceberConfirmacao" />
    <bpmn:messageFlow id="Flow_EnvioDoc" sourceRef:Activity_EnviarDocs" targetRef:Event_ReceberDocs" />
    <bpmn:messageFlow id="Flow_DocIncorreta" sourceRef:Activity_SolicitarCorrecao" targetRef:Event_ReceberSolicitacaoCorrecao" />
    <bpmn:messageFlow id="Flow_AvisoLimpeza" sourceRef:Activity_InformarPronto" targetRef:Event_ReceberAvisoLimpeza" />
    <bpmn:messageFlow id="Flow_EntregaChave" sourceRef:Activity_EntregarChave" targetRef:Event_ReceberChave" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Guest" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Guest" name="Necessidade de Hospedagem">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_SolicitarReserva" name="Solicitar Reserva">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="Gateway_EsperaResposta">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_ReceberNegativa" name="Negativa Recebida">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_ReceberConfirmacao" name="Confirmação Recebida">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_AguardarChegada" name="Aguardar 2 dias até a chegada">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Activity_EnviarDocs" name="Apresentar Documentação">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_CorrecaoFeita</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_ReceberSolicitacaoCorrecao" name="Solicitação de Correção">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Activity_CorrigirDocs" name="Corrigir Documentação">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_CorrecaoFeita</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_ReceberChave" name="Chave Recebida">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_4" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_GuestSuccess" name="Hospedagem Iniciada">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_GuestCancel" name="Processo Cancelado">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Guest" targetRef="Activity_SolicitarReserva" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_SolicitarReserva" targetRef="Gateway_EsperaResposta" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_EsperaResposta" targetRef="Event_ReceberNegativa" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_EsperaResposta" targetRef="Event_ReceberConfirmacao" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Event_ReceberNegativa" targetRef="EndEvent_GuestCancel" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Event_ReceberConfirmacao" targetRef="Event_AguardarChegada" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Event_AguardarChegada" targetRef="Activity_EnviarDocs" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_EnviarDocs" targetRef="Event_ReceberSolicitacaoCorrecao" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_EnviarDocs" targetRef="Event_ReceberChave" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_ReceberSolicitacaoCorrecao" targetRef="Activity_CorrigirDocs" />
    <bpmn:sequenceFlow id="Flow_CorrecaoFeita" sourceRef="Activity_CorrigirDocs" targetRef="Activity_EnviarDocs" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Event_ReceberChave" targetRef="EndEvent_GuestSuccess" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Event_ReceberChave" targetRef="EndEvent_GuestSuccess" />
  </bpmn:process>
  <bpmn:process id="Process_Reception" isExecutable="false">
    <bpmn:startEvent id="Event_ReceberSolicitacao" name="Solicitação Recebida">
      <bpmn:outgoing>Flow_R1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_5" />
    </bpmn:startEvent>
    <bpmn:task id="Activity_VerificarDisp" name="Verificar Disponibilidade">
      <bpmn:incoming>Flow_R1</bpmn:incoming>
      <bpmn:outgoing>Flow_R2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_TemQuarto" name="Há Quarto?">
      <bpmn:incoming>Flow_R2</bpmn:incoming>
      <bpmn:outgoing>Flow_NaoTem</bpmn:outgoing>
      <bpmn:outgoing>Flow_Tem</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_InformarSemQuarto" name="Informar Hóspede (Sem Quarto)">
      <bpmn:incoming>Flow_NaoTem</bpmn:incoming>
      <bpmn:outgoing>Flow_R3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_RecepcaoFim" name="Processo Encerrado">
      <bpmn:incoming>Flow_R3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Activity_ConfirmarReserva" name="Confirmar Reserva">
      <bpmn:incoming>Flow_Tem</bpmn:incoming>
      <bpmn:outgoing>Flow_R4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_ReceberDocs" name="Receber Documentação">
      <bpmn:incoming>Flow_R4</bpmn:incoming>
      <bpmn:outgoing>Flow_R5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_6" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_DocCorreta" name="Documentação Correta?">
      <bpmn:incoming>Flow_R5</bpmn:incoming>
      <bpmn:outgoing>Flow_DocIncorreta_Out</bpmn:outgoing>
      <bpmn:outgoing>Flow_DocCorreta_Out</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_SolicitarCorrecao" name="Solicitar Correção de Documentos">
      <bpmn:incoming>Flow_DocIncorreta_Out</bpmn:incoming>
      <bpmn:outgoing>Flow_R6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_ReceberDocsRevisao" name="Receber Docs Corrigidos">
      <bpmn:incoming>Flow_R6</bpmn:incoming>
      <bpmn:outgoing>Flow_R7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_7" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Activity_SolicitarLimpeza" name="Solicitar Limpeza do Quarto">
      <bpmn:incoming>Flow_DocCorreta_Out</bpmn:incoming>
      <bpmn:incoming>Flow_R7</bpmn:incoming>
      <bpmn:outgoing>Flow_R8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_ReceberAvisoLimpeza" name="Aviso de Limpeza Concluída">
      <bpmn:incoming>Flow_R8</bpmn:incoming>
      <bpmn:outgoing>Flow_R9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_8" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Activity_EntregarChave" name="Entregar Chave ao Hóspede">
      <bpmn:incoming>Flow_R9</bpmn:incoming>
      <bpmn:outgoing>Flow_R10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_RecepcaoSucesso" name="Check-in Finalizado">
      <bpmn:incoming>Flow_R10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_R1" sourceRef="Event_ReceberSolicitacao" targetRef="Activity_VerificarDisp" />
    <bpmn:sequenceFlow id="Flow_R2" sourceRef="Activity_VerificarDisp" targetRef="Gateway_TemQuarto" />
    <bpmn:sequenceFlow id="Flow_NaoTem" name="Não" sourceRef="Gateway_TemQuarto" targetRef="Activity_InformarSemQuarto" />
    <bpmn:sequenceFlow id="Flow_R3" sourceRef="Activity_InformarSemQuarto" targetRef="EndEvent_RecepcaoFim" />
    <bpmn:sequenceFlow id="Flow_Tem" name="Sim" sourceRef="Gateway_TemQuarto" targetRef="Activity_ConfirmarReserva" />
    <bpmn:sequenceFlow id="Flow_R4" sourceRef="Activity_ConfirmarReserva" targetRef="Event_ReceberDocs" />
    <bpmn:sequenceFlow id="Flow_R5" sourceRef="Event_ReceberDocs" targetRef="Gateway_DocCorreta" />
    <bpmn:sequenceFlow id="Flow_DocIncorreta_Out" name="Incorreta" sourceRef="Gateway_DocCorreta" targetRef="Activity_SolicitarCorrecao" />
    <bpmn:sequenceFlow id="Flow_R6" sourceRef="Activity_SolicitarCorrecao" targetRef="Event_ReceberDocsRevisao" />
    <bpmn:sequenceFlow id="Flow_R7" sourceRef="Event_ReceberDocsRevisao" targetRef="Activity_SolicitarLimpeza" />
    <bpmn:sequenceFlow id="Flow_DocCorreta_Out" name="Correta" sourceRef="Gateway_DocCorreta" targetRef="Activity_SolicitarLimpeza" />
    <bpmn:sequenceFlow id="Flow_R8" sourceRef="Activity_SolicitarLimpeza" targetRef="Event_ReceberAvisoLimpeza" />
    <bpmn:sequenceFlow id="Flow_R9" sourceRef="Event_ReceberAvisoLimpeza" targetRef="Activity_EntregarChave" />
    <bpmn:sequenceFlow id="Flow_R10" sourceRef="Activity_EntregarChave" targetRef="EndEvent_RecepcaoSucesso" />
  </bpmn:process>
  <bpmn:process id="Process_Cleaning" isExecutable="false">
    <bpmn:startEvent id="Event_LimpezaInicio" name="Solicitação de Limpeza Recebida">
      <bpmn:outgoing>Flow_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_PrepararQuarto" name="Preparar e Higienizar Quarto">
      <bpmn:incoming>Flow_C1</bpmn:incoming>
      <bpmn:outgoing>Flow_C2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_InformarPronto" name="Informar Recepção (Quarto Pronto)">
      <bpmn:incoming>Flow_C2</bpmn:incoming>
      <bpmn:outgoing>Flow_C3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_LimpezaFim" name="Quarto Pronto">
      <bpmn:incoming>Flow_C3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C1" sourceRef="Event_LimpezaInicio" targetRef="Activity_PrepararQuarto" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Activity_PrepararQuarto" targetRef="Activity_InformarPronto" />
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="Activity_InformarPronto" targetRef="EndEvent_LimpezaFim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Hotel">
      <bpmndi:BPMNShape id="Participant_Guest_di" bpmnElement="Participant_Guest" isHorizontal="true">
