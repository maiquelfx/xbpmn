<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.8.1">
  <collaboration id="Collaboration_1">
    <participant id="Participant_Usuario" name="Usuário" processRef="Process_Usuario" />
    <participant id="Participant_Suporte1" name="Suporte Nível 1" processRef="Process_Suporte1" />
    <participant id="Participant_Suporte2" name="Suporte Nível 2" processRef="Process_Suporte2" />
    <participant id="Participant_Infra" name="Equipe de Infraestrutura" processRef="Process_Infra" />
    <messageFlow id="Flow_AbreChamado" sourceRef="Event_InicioChamado" targetRefRef="Event_RecebeChamado" />
    <messageFlow id="Flow_EscalaN2" sourceRef="Event_Timer4h" targetRefRef="Event_RecebeN2" />
    <messageFlow id="Flow_AcionaInfra" sourceRef="Task_AcionarInfra" targetRefRef="Event_RecebeInfra" />
    <messageFlow id="Flow_RetornoInfra" sourceRef="Task_ResolverInfra" targetRefRef="Task_AvaliarProblema" />
    <messageFlow id="Flow_EnviaSolucao" sourceRef="Task_EncerrarN2" targetRefRef="Event_RecebeSolucao" />
    <messageFlow id="Flow_RejeitaSolucao" sourceRef="Task_RejeitarSolucao" targetRefRef="Event_RecebeRejeicao" />
    <messageFlow id="Flow_RevisaSolucao" sourceRef="Task_RevisarSolucao" targetRefRef="Event_RecebeSolucao" />
  </collaboration>
  <process id="Process_Usuario" isExecutable="false">
    <startEvent id="Event_InicioChamado" name="Abrir Chamado de TI">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <task id="Task_AvaliarSolucao" name="Avaliar Solução Proposta">
      <incoming>Flow_RecebeSolucaoSeq</incoming>
      <outgoing>Flow_2</outgoing>
    </task>
    <exclusiveGateway id="Gateway_Avaliacao" name="Solução Aceita?">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_Aceito</outgoing>
      <outgoing>Flow_Rejeitado</outgoing>
    </exclusiveGateway>
    <task id="Task_RejeitarSolucao" name="Rejeitar Solução e Justificar">
      <incoming>Flow_Rejeitado</incoming>
      <outgoing>Flow_3</outgoing>
    </task>
    <task id="Task_ConfirmarSolucao" name="Confirmar e Fechar Chamado">
      <incoming>Flow_Aceito</incoming>
      <outgoing>Flow_4</outgoing>
    </task>
    <endEvent id="Event_FimUsuario" name="Chamado Encerrado">
      <incoming>Flow_4</incoming>
    </endEvent>
    <intermediateCatchEvent id="Event_RecebeSolucao" name="Solução Recebida">
      <incoming>Flow_1</incoming>
      <incoming>Flow_RebeRejeicaoSeq</incoming>
      <outgoing>Flow_RecebeSolucaoSeq</outgoing>
      <messageEventDefinition id="MessageEventDefinition_1" />
    </intermediateCatchEvent>
    <intermediateCatchEvent id="Event_RecebeRejeicao" name="Retorno Revisão">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_RebeRejeicaoSeq</outgoing>
      <messageEventDefinition id="MessageEventDefinition_2" />
    </intermediateCatchEvent>
    <sequenceFlow id="Flow_1" sourceRef="Event_InicioChamado" targetRef="Event_RecebeSolucao" />
    <sequenceFlow id="Flow_RecebeSolucaoSeq" sourceRef="Event_RecebeSolucao" targetRef="Task_AvaliarSolucao" />
    <sequenceFlow id="Flow_2" sourceRef="Task_AvaliarSolucao" targetRef="Gateway_Avaliacao" />
    <sequenceFlow id="Flow_Aceito" name="Sim" sourceRef="Gateway_Avaliacao" targetRef="Task_ConfirmarSolucao" />
    <sequenceFlow id="Flow_Rejeitado" name="Não" sourceRef="Gateway_Avaliacao" targetRef="Task_RejeitarSolucao" />
    <sequenceFlow id="Flow_3" sourceRef="Task_RejeitarSolucao" targetRef="Event_RecebeRejeicao" />
    <sequenceFlow id="Flow_RebeRejeicaoSeq" sourceRef="Event_RecebeRejeicao" targetRef="Event_RecebeSolucao" />
    <sequenceFlow id="Flow_4" sourceRef="Task_ConfirmarSolucao" targetRef="Event_FimUsuario" />
  </process>
  <process id="Process_Suporte1" isExecutable="false">
    <startEvent id="Event_RecebeChamado" name="Chamado Recebido">
      <outgoing>Flow_5</outgoing>
      <messageEventDefinition id="MessageEventDefinition_3" />
    </startEvent>
    <task id="Task_AnalisarN1" name="Analisar e Tentar Resolver">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
    </task>
    <exclusiveGateway id="Gateway_N1" name="Resolvido em 4h?">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_ResolvidoN1</outgoing>
      <outgoing>Flow_NaoResolvidoN1</outgoing>
    </exclusiveGateway>
    <endEvent id="Event_FimN1" name="Chamado Resolvido N1">
      <incoming>Flow_ResolvidoN1</incoming>
    </endEvent>
    <endEvent id="Event_EscaladoN2" name="Escalado para N2">
      <incoming>Flow_NaoResolvidoN1Seq</incoming>
    </endEvent>
    <boundaryEvent id="Event_Timer4h" name="Prazo 4 Horas" cancelActivity="true" attachedToRefId="Task_AnalisarN1">
      <outgoing>Flow_NaoResolvidoN1Seq</outgoing>
      <timerEventDefinition id="TimerEventDefinition_1" />
    </boundaryEvent>
    <sequenceFlow id="Flow_5" sourceRef="Event_RecebeChamado" targetRef="Task_AnalisarN1" />
    <sequenceFlow id="Flow_6" sourceRef="Task_AnalisarN1" targetRef="Gateway_N1" />
    <sequenceFlow id="Flow_ResolvidoN1" name="Sim" sourceRef="Gateway_N1" targetRef="Event_FimN1" />
    <sequenceFlow id="Flow_NaoResolvidoN1" name="Não (Manual)" sourceRef="Gateway_N1" targetRef="Event_EscaladoN2" />
    <sequenceFlow id="Flow_NaoResolvidoN1Seq" sourceRef="Event_Timer4h" targetRef="Event_EscaladoN2" />
  </process>
  <process id="Process_Suporte2" isExecutable="false">
    <startEvent id="Event_RecebeN2" name="Chamado Escalado">
      <outgoing>Flow_7</outgoing>
      <messageEventDefinition id="MessageEventDefinition_4" />
    </startEvent>
    <task id="Task_AvaliarProblema" name="Avaliar Tipo de Problema">
      <incoming>Flow_7</incoming>
      <incoming>Flow_RetornoRevisaoSeq</incoming>
      <outgoing>Flow_8</outgoing>
    </task>
    <exclusiveGateway id="Gateway_TipoProblema" name="É Infraestrutura?">
      <incoming>Flow_8</incoming>
      <outgoing>Flow_SimInfra</outgoing>
      <outgoing>Flow_NaoInfra</outgoing>
    </exclusiveGateway>
    <task id="Task_AcionarInfra" name="Acionar Equipe de Infraestrutura">
      <incoming>Flow_SimInfra</incoming>
      <outgoing>Flow_9</outgoing>
    </task>
    <task id="Task_ResolverDireto" name="Resolver Diretamente">
      <incoming>Flow_NaoInfra</incoming>
      <outgoing>Flow_10</outgoing>
    </task>
    <exclusiveGateway id="Gateway_JoinN2">
      <incoming>Flow_9</incoming>
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
    </exclusiveGateway>
    <task id="Task_EncerrarN2" name="Enviar Solução para Usuário">
      <incoming>Flow_11</incoming>
      <outgoing>Flow_12</outgoing>
    </task>
    <intermediateCatchEvent id="Event_RecebeRejeicaoN2" name="Rejeição Recebida">
      <incoming>Flow_12</incoming>
      <outgoing>Flow_13</outgoing>
      <messageEventDefinition id="MessageEventDefinition_5" />
    </intermediateCatchEvent>
    <task id="Task_RevisarSolucao" name="Revisar Solução">
      <incoming>Flow_13</incoming>
      <outgoing>Flow_RetornoRevisaoSeq</outgoing>
    </task>
    <sequenceFlow id="Flow_7" sourceRef="Event_RecebeN2" targetRef="Task_AvaliarProblema" />
    <sequenceFlow id="Flow_8" sourceRef="Task_AvaliarProblema" targetRef="Gateway_TipoProblema" />
    <sequenceFlow id="Flow_SimInfra" name="Sim" sourceRef="Gateway_TipoProblema" targetRef="Task_AcionarInfra" />
    <sequenceFlow id="Flow_NaoInfra" name="Não" sourceRef="Gateway_TipoProblema" targetRef="Task_ResolverDireto" />
    <sequenceFlow id="Flow_9" sourceRef="Task_AcionarInfra" targetRef="Gateway_JoinN2" />
    <sequenceFlow id="Flow_10" sourceRef="Task_ResolverDireto" targetRef="Gateway_JoinN2" />
    <sequenceFlow id="Flow_11" sourceRef="Gateway_JoinN2" targetRef="Task_EncerrarN2" />
    <sequenceFlow id="Flow_12" sourceRef="Task_EncerrarN2" targetRef="Event_RecebeRejeicaoN2" />
    <sequenceFlow id="Flow_13" sourceRef="Event_RecebeRejeicaoN2" targetRef="Task_RevisarSolucao" />
    <sequenceFlow id="Flow_RetornoRevisaoSeq" sourceRef="Task_RevisarSolucao" targetRef="Task_AvaliarProblema" />
  </process>
  <process id="Process_Infra" isExecutable="false">
    <startEvent id="Event_RecebeInfra" name="Demanda Recebida">
      <outgoing>Flow_14</outgoing>
      <messageEventDefinition id="MessageEventDefinition_6" />
    </startEvent>
    <task id="Task_ResolverInfra" name="Resolver Problema de Infraestrutura">
      <incoming>Flow_14</incoming>
      <outgoing>Flow_15</outgoing>
    </task>
    <endEvent id="Event_FimInfra" name="Infraestrutura Resolvida">
      <incoming>Flow_15</incoming>
    </endEvent>
    <sequenceFlow id="Flow_14" sourceRef="Event_RecebeInfra" targetRef="Task_ResolverInfra" />
    <sequenceFlow id="Flow_15" sourceRef="Task_ResolverInfra" targetRef="Event_FimInfra" />
  </process>
