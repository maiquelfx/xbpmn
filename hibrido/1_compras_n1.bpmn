<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_lane_solicitante" name="Solicitante" processRef="Process_lane_solicitante" />
    <bpmn:participant id="Participant_lane_comprador" name="Comprador" processRef="Process_lane_comprador" />
    <bpmn:participant id="Participant_lane_financeiro" name="Financeiro" processRef="Process_lane_financeiro" />
    <bpmn:participant id="Participant_lane_fornecedor" name="Fornecedor" processRef="Process_lane_fornecedor" />
    <bpmn:messageFlow id="MessageFlow_send_pedido_msg_receber_pedido" sourceRef="send_pedido" targetRef="msg_receber_pedido" />
    <bpmn:messageFlow id="MessageFlow_send_cotacao_forn_msg_receber_orcamento" sourceRef="send_cotacao_forn" targetRef="msg_receber_orcamento" />
    <bpmn:messageFlow id="MessageFlow_send_proposta_receive_proposta" sourceRef="send_proposta" targetRef="receive_proposta" />
    <bpmn:messageFlow id="MessageFlow_send_fatura_fin_msg_receber_fatura" sourceRef="send_fatura_fin" targetRef="msg_receber_fatura" />
  </bpmn:collaboration>
  <bpmn:process id="Process_lane_solicitante" isExecutable="false">
    <bpmn:startEvent id="start_1" name="Novo Pedido Solicitado" />
    <bpmn:userTask id="task_criar_pedido" name="Elaborar Pedido de Compra" />
    <bpmn:sendTask id="send_pedido" name="Enviar Pedido para Comprador" />
    <bpmn:sequenceFlow id="Flow_start_1_task_criar_pedido" sourceRef="start_1" targetRef="task_criar_pedido" />
    <bpmn:sequenceFlow id="Flow_task_criar_pedido_send_pedido" sourceRef="task_criar_pedido" targetRef="send_pedido" />
  </bpmn:process>
  <bpmn:process id="Process_lane_comprador" isExecutable="false">
    <bpmn:intermediateCatchEvent id="msg_receber_pedido" name="Pedido Recebido">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="task_analisar_pedido" name="Analisar Especificações" />
    <bpmn:exclusiveGateway id="gateway_orcamento" name="Valor Alto?" />
    <bpmn:serviceTask id="task_cotar_simples" name="Realizar Cotação Única" />
    <bpmn:serviceTask id="task_cotar_multipla" name="Realizar Multiplas Cotações" />
    <bpmn:parallelGateway id="gateway_juntarcotas" name="Cotações Finalizadas" />
    <bpmn:sendTask id="send_cotacao_forn" name="Solicitar Orçamento ao Fornecedor" />
    <bpmn:receiveTask id="receive_proposta" name="Receber Proposta Fornecedor" />
    <bpmn:userTask id="task_selecionar_melhor" name="Selecionar Melhor Oferta" />
    <bpmn:sendTask id="send_fatura_fin" name="Enviar Fatura para Pagamento" />
    <bpmn:sequenceFlow id="Flow_msg_receber_pedido_task_analisar_pedido" sourceRef="msg_receber_pedido" targetRef="task_analisar_pedido" />
    <bpmn:sequenceFlow id="Flow_task_analisar_pedido_gateway_orcamento" sourceRef="task_analisar_pedido" targetRef="gateway_orcamento" />
    <bpmn:sequenceFlow id="Flow_gateway_orcamento_task_cotar_simples" sourceRef="gateway_orcamento" targetRef="task_cotar_simples" name="Não" />
    <bpmn:sequenceFlow id="Flow_gateway_orcamento_task_cotar_multipla" sourceRef="gateway_orcamento" targetRef="task_cotar_multipla" name="Sim" />
    <bpmn:sequenceFlow id="Flow_task_cotar_simples_gateway_juntarcotas" sourceRef="task_cotar_simples" targetRef="gateway_juntarcotas" />
    <bpmn:sequenceFlow id="Flow_task_cotar_multipla_gateway_juntarcotas" sourceRef="task_cotar_multipla" targetRef="gateway_juntarcotas" />
    <bpmn:sequenceFlow id="Flow_gateway_juntarcotas_send_cotacao_forn" sourceRef="gateway_juntarcotas" targetRef="send_cotacao_forn" />
    <bpmn:sequenceFlow id="Flow_receive_proposta_task_selecionar_melhor" sourceRef="receive_proposta" targetRef="task_selecionar_melhor" />
    <bpmn:sequenceFlow id="Flow_task_selecionar_melhor_send_fatura_fin" sourceRef="task_selecionar_melhor" targetRef="send_fatura_fin" />
  </bpmn:process>
  <bpmn:process id="Process_lane_financeiro" isExecutable="false">
    <bpmn:intermediateCatchEvent id="msg_receber_fatura" name="Fatura Recebida">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timer_pagamento" name="Aguardar Vencimento">
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="task_efetuar_pagamento" name="Efetuar Transferência Bancária" />
    <bpmn:task id="task_notificar_conclusao" name="Registrar Conclusão do Pagamento" />
    <bpmn:endEvent id="end_sucesso" name="Processo Concluído com Sucesso">
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_msg_receber_fatura_timer_pagamento" sourceRef="msg_receber_fatura" targetRef="timer_pagamento" />
    <bpmn:sequenceFlow id="Flow_timer_pagamento_task_efetuar_pagamento" sourceRef="timer_pagamento" targetRef="task_efetuar_pagamento" />
    <bpmn:sequenceFlow id="Flow_task_efetuar_pagamento_task_notificar_conclusao" sourceRef="task_efetuar_pagamento" targetRef="task_notificar_conclusao" />
    <bpmn:sequenceFlow id="Flow_task_notificar_conclusao_end_sucesso" sourceRef="task_notificar_conclusao" targetRef="end_sucesso" />
  </bpmn:process>
  <bpmn:process id="Process_lane_fornecedor" isExecutable="false">
    <bpmn:intermediateCatchEvent id="msg_receber_orcamento" name="Aguardar Resposta do Fornecedor">
