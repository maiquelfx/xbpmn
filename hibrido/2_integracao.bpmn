<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_lane_funcionario" name="Novo Funcionário" processRef="Process_lane_funcionario" />
    <bpmn:participant id="Participant_lane_rh" name="Recursos Humanos" processRef="Process_lane_rh" />
    <bpmn:participant id="Participant_lane_ti" name="Setor de TI" processRef="Process_lane_ti" />
    <bpmn:participant id="Participant_lane_gestor" name="Gestor de Equipe" processRef="Process_lane_gestor" />
    <bpmn:messageFlow id="MessageFlow_t_enviar_t_receber_docs" sourceRef="t_enviar" targetRef="t_receber_docs" />
    <bpmn:messageFlow id="MessageFlow_t_enviar_falta_t_receber_falta" sourceRef="t_enviar_falta" targetRef="t_receber_falta" />
    <bpmn:messageFlow id="MessageFlow_t_re_enviar_t_receber_docs" sourceRef="t_re_enviar" targetRef="t_receber_docs" />
    <bpmn:messageFlow id="MessageFlow_t_avisar_ti_t_receber_ti" sourceRef="t_avisar_ti" targetRef="t_receber_ti" />
    <bpmn:messageFlow id="MessageFlow_t_avisar_gestor_t_receber_gestor" sourceRef="t_avisar_gestor" targetRef="t_receber_gestor" />
  </bpmn:collaboration>
  <bpmn:process id="Process_lane_funcionario" isExecutable="false">
    <bpmn:startEvent id="start_msg" name="Enviar Dados Iniciais">
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:sendTask id="t_enviar" name="Submeter Documentação" />
    <bpmn:receiveTask id="t_receber_falta" name="Receber Documentos Faltantes" />
    <bpmn:sendTask id="t_re_enviar" name="Reenviar Documentação" />
    <bpmn:sequenceFlow id="Flow_start_msg_t_enviar" sourceRef="start_msg" targetRef="t_enviar" />
    <bpmn:sequenceFlow id="Flow_t_receber_falta_t_re_enviar" sourceRef="t_receber_falta" targetRef="t_re_enviar" />
  </bpmn:process>
  <bpmn:process id="Process_lane_rh" isExecutable="false">
    <bpmn:receiveTask id="t_receber_docs" name="Receber Documentos" />
    <bpmn:task id="t_analisar" name="Verificar Documentação" />
    <bpmn:exclusiveGateway id="gw_completo" name="Documentação Completa?" />
    <bpmn:task id="t_solicitar" name="Preparar Solicitação de Pendências" />
    <bpmn:sendTask id="t_enviar_falta" name="Enviar Documentos Faltantes" />
    <bpmn:task id="t_processar_ok" name="Registrar Aprovação de Documentos" />
    <bpmn:sendTask id="t_avisar_ti" name="Notificar Criação de Acesso" />
    <bpmn:sequenceFlow id="Flow_t_receber_docs_t_analisar" sourceRef="t_receber_docs" targetRef="t_analisar" />
    <bpmn:sequenceFlow id="Flow_t_analisar_gw_completo" sourceRef="t_analisar" targetRef="gw_completo" />
    <bpmn:sequenceFlow id="Flow_gw_completo_t_solicitar" sourceRef="gw_completo" targetRef="t_solicitar" name="Não" />
    <bpmn:sequenceFlow id="Flow_t_solicitar_t_enviar_falta" sourceRef="t_solicitar" targetRef="t_enviar_falta" />
    <bpmn:sequenceFlow id="Flow_gw_completo_t_processar_ok" sourceRef="gw_completo" targetRef="t_processar_ok" name="Sim" />
    <bpmn:sequenceFlow id="Flow_t_processar_ok_t_avisar_ti" sourceRef="t_processar_ok" targetRef="t_avisar_ti" />
  </bpmn:process>
  <bpmn:process id="Process_lane_ti" isExecutable="false">
    <bpmn:intermediateCatchEvent id="t_receber_ti" name="Receber Pedido de Acesso">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="t_criar_acesso" name="Criar Contas e Credenciais" />
    <bpmn:sendTask id="t_avisar_gestor" name="Enviar Aviso de Acessos Prontos" />
    <bpmn:sequenceFlow id="Flow_t_receber_ti_t_criar_acesso" sourceRef="t_receber_ti" targetRef="t_criar_acesso" />
    <bpmn:sequenceFlow id="Flow_t_criar_acesso_t_avisar_gestor" sourceRef="t_criar_acesso" targetRef="t_avisar_gestor" />
  </bpmn:process>
  <bpmn:process id="Process_lane_gestor" isExecutable="false">
    <bpmn:intermediateCatchEvent id="t_receber_gestor" name="Receber Notificação de Acessos">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="t_apresentar" name="Apresentar Equipe ao Novo Funcionário" />
    <bpmn:task id="t_finalizar" name="Concluir Processo de Onboarding" />
    <bpmn:endEvent id="end_event" name="Fim do Onboarding" />
    <bpmn:sequenceFlow id="Flow_t_receber_gestor_t_apresentar" sourceRef="t_receber_gestor" targetRef="t_apresentar" />
    <bpmn:sequenceFlow id="Flow_t_apresentar_t_finalizar" sourceRef="t_apresentar" targetRef="t_finalizar" />
    <bpmn:sequenceFlow id="Flow_t_finalizar_end_event" sourceRef="t_finalizar" targetRef="end_event" />
  </bpmn:process>
