  </bpmn:collaboration>
  <bpmn:process id="Process_lane_colaborador" isExecutable="false">
    <bpmn:startEvent id="start1" name="Solicitação de Viagem Iniciada" />
    <bpmn:userTask id="t1" name="Preencher Formulário de Viagem" />
    <bpmn:sendTask id="t2" name="Enviar Solicitação ao Gestor" />
    <bpmn:intermediateCatchEvent id="msg2" name="Receber Rejeição">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="t5" name="Revisar Solicitação" />
    <bpmn:sendTask id="t6" name="Reenviar Solicitação" />
    <bpmn:intermediateCatchEvent id="msg4" name="Receber Confirmação da Viagem">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t9" name="Arquivar Documentação" />
    <bpmn:endEvent id="end1" name="Processo Concluído com Sucesso">
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start1_t1" sourceRef="start1" targetRef="t1" />
