      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t3" name="Analisar Viagem" />
    <bpmn:intermediateCatchEvent id="timer1" name="Aguardar Prazo de Avaliação">
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g1" name="Aprovado?" />
    <bpmn:sendTask id="t4" name="Notificar Rejeição" />
    <bpmn:sendTask id="t7" name="Encaminhar para Agência" />
    <bpmn:sequenceFlow id="Flow_msg1_t3" sourceRef="msg1" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_t3_timer1" sourceRef="t3" targetRef="timer1" />
