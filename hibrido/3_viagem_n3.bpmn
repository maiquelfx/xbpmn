  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_lane_colaborador" name="Colaborador" processRef="Process_lane_colaborador" />
    <bpmn:participant id="Participant_lane_gestor" name="Gerência" processRef="Process_lane_gestor" />
    <bpmn:participant id="Participant_lane_agencia" name="Agência de Viagens" processRef="Process_lane_agencia" />
    <bpmn:messageFlow id="MessageFlow_t2_msg1" sourceRef="t2" targetRef="msg1" />
    <bpmn:messageFlow id="MessageFlow_t4_msg2" sourceRef="t4" targetRef="msg2" />
