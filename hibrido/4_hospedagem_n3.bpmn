  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_lane_guest" name="Hóspede" processRef="Process_lane_guest" />
    <bpmn:participant id="Participant_lane_reception" name="Recepção" processRef="Process_lane_reception" />
    <bpmn:participant id="Participant_lane_cleaning" name="Equipe de Limpeza" processRef="Process_lane_cleaning" />
    <bpmn:messageFlow id="MessageFlow_t_send_req_t_recv_req" sourceRef="t_send_req" targetRef="t_recv_req" />
    <bpmn:messageFlow id="MessageFlow_t_send_confirm_t_recv_confirm" sourceRef="t_send_confirm" targetRef="t_recv_confirm" />
    <bpmn:messageFlow id="MessageFlow_t_send_docs_t_recv_docs" sourceRef="t_send_docs" targetRef="t_recv_docs" />
    <bpmn:messageFlow id="MessageFlow_t_ask_correction_t_send_correction" sourceRef="t_ask_correction" targetRef="t_send_correction" />
    <bpmn:messageFlow id="MessageFlow_t_send_correction_t_recv_docs" sourceRef="t_send_correction" targetRef="t_recv_docs" />
    <bpmn:messageFlow id="MessageFlow_t_notify_clean_t_recv_clean" sourceRef="t_notify_clean" targetRef="t_recv_clean" />
    <bpmn:messageFlow id="MessageFlow_t_deliver_key_t_receive_key" sourceRef="t_deliver_key" targetRef="t_receive_key" />
