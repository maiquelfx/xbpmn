  </bpmn:collaboration>
  <bpmn:process id="Process_lane_guest" isExecutable="false">
    <bpmn:startEvent id="start_msg" name="Solicitar Reserva">
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:sendTask id="t_send_req" name="Enviar Pedido de Reserva" />
    <bpmn:receiveTask id="t_recv_confirm" name="Receber Confirmação" />
    <bpmn:intermediateCatchEvent id="timer_wait" name="Aguardar 2 Dias">
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t_arrive" name="Chegar ao Hotel" />
    <bpmn:sendTask id="t_send_docs" name="Apresentar Documentação" />
    <bpmn:sendTask id="t_send_correction" name="Enviar Documentos Corrigidos" />
    <bpmn:receiveTask id="t_receive_key" name="Receber Chave" />
    <bpmn:endEvent id="end_process" name="Finalizar Estadia Inicial" />
    <bpmn:sequenceFlow id="Flow_start_msg_t_send_req" sourceRef="start_msg" targetRef="t_send_req" />
    <bpmn:sequenceFlow id="Flow_t_recv_confirm_timer_wait" sourceRef="t_recv_confirm" targetRef="timer_wait" />
    <bpmn:sequenceFlow id="Flow_timer_wait_t_arrive" sourceRef="timer_wait" targetRef="t_arrive" />
    <bpmn:sequenceFlow id="Flow_t_arrive_t_send_docs" sourceRef="t_arrive" targetRef="t_send_docs" />
    <bpmn:sequenceFlow id="Flow_t_receive_key_end_process" sourceRef="t_receive_key" targetRef="end_process" />
  </bpmn:process>
  <bpmn:process id="Process_lane_reception" isExecutable="false">
    <bpmn:receiveTask id="t_recv_req" name="Receber Pedido de Reserva" />
    <bpmn:task id="t_check_disp" name="Verificar Disponibilidade" />
    <bpmn:exclusiveGateway id="gw_disp" name="Quarto Disponível?" />
    <bpmn:task id="t_notify_no_room" name="Preparar Aviso de Indisponibilidade" />
    <bpmn:endEvent id="end_no_room" name="Enviar Aviso de Indisponibilidade">
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="t_confirm" name="Confirmar Reserva" />
    <bpmn:sendTask id="t_send_confirm" name="Enviar Confirmação" />
    <bpmn:receiveTask id="t_recv_docs" name="Receber Documentação" />
    <bpmn:exclusiveGateway id="gw_docs" name="Documentação Correta?" />
    <bpmn:task id="t_ask_correction" name="Solicitar Correção de Documentos" />
    <bpmn:receiveTask id="t_recv_clean" name="Receber Notificação de Limpeza" />
    <bpmn:task id="t_deliver_key" name="Entregar Chave" />
    <bpmn:task id="auto_task_gw_docs_t_prepare_room" name="Executar ação" />
    <bpmn:sequenceFlow id="Flow_t_recv_req_t_check_disp" sourceRef="t_recv_req" targetRef="t_check_disp" />
    <bpmn:sequenceFlow id="Flow_t_check_disp_gw_disp" sourceRef="t_check_disp" targetRef="gw_disp" />
