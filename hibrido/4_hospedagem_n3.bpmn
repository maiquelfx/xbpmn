    <bpmn:sequenceFlow id="Flow_gw_disp_t_confirm" sourceRef="gw_disp" targetRef="t_confirm" name="Sim" />
    <bpmn:sequenceFlow id="Flow_t_confirm_t_send_confirm" sourceRef="t_confirm" targetRef="t_send_confirm" />
    <bpmn:sequenceFlow id="Flow_t_recv_docs_gw_docs" sourceRef="t_recv_docs" targetRef="gw_docs" />
    <bpmn:sequenceFlow id="Flow_gw_docs_t_ask_correction" sourceRef="gw_docs" targetRef="t_ask_correction" name="Incorreta" />
    <bpmn:sequenceFlow id="Flow_gw_docs_auto_task_gw_docs_t_prepare_room" sourceRef="gw_docs" targetRef="auto_task_gw_docs_t_prepare_room" name="Correta" />
    <bpmn:sequenceFlow id="Flow_t_recv_clean_t_deliver_key" sourceRef="t_recv_clean" targetRef="t_deliver_key" />
  </bpmn:process>
