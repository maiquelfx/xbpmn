<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_lane_user" name="Usuário" processRef="Process_lane_user" />
    <bpmn:participant id="Participant_lane_sup1" name="Suporte Nível 1" processRef="Process_lane_sup1" />
    <bpmn:participant id="Participant_lane_sup2" name="Suporte Nível 2" processRef="Process_lane_sup2" />
    <bpmn:participant id="Participant_lane_infra" name="Equipe de Infraestrutura" processRef="Process_lane_infra" />
    <bpmn:messageFlow id="MessageFlow_task_send_req_msg_recv_req" sourceRef="task_send_req" targetRef="msg_recv_req" />
    <bpmn:messageFlow id="MessageFlow_task_resolvido_n1_msg_recv_solucao" sourceRef="task_resolvido_n1" targetRef="msg_recv_solucao" />
    <bpmn:messageFlow id="MessageFlow_send_escalar_msg_recv_n2" sourceRef="send_escalar" targetRef="msg_recv_n2" />
    <bpmn:messageFlow id="MessageFlow_send_infra_msg_recv_infra" sourceRef="send_infra" targetRef="msg_recv_infra" />
    <bpmn:messageFlow id="MessageFlow_send_infra_resp_msg_recv_infra_resp" sourceRef="send_infra_resp" targetRef="msg_recv_infra_resp" />
    <bpmn:messageFlow id="MessageFlow_send_solucao_user_msg_recv_solucao" sourceRef="send_solucao_user" targetRef="msg_recv_solucao" />
    <bpmn:messageFlow id="MessageFlow_send_rejeicao_msg_recv_rejeicao" sourceRef="send_rejeicao" targetRef="msg_recv_rejeicao" />
    <bpmn:messageFlow id="MessageFlow_send_nova_solucao_msg_recv_solucao" sourceRef="send_nova_solucao" targetRef="msg_recv_solucao" />
  </bpmn:collaboration>
  <bpmn:process id="Process_lane_user" isExecutable="false">
    <bpmn:startEvent id="start1" name="Abrir Chamado de TI" />
    <bpmn:sendTask id="task_send_req" name="Enviar Chamado" />
    <bpmn:intermediateCatchEvent id="msg_recv_solucao" name="Receber Notificação de Solução">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="task_avaliar_solucao" name="Testar e Avaliar Solução" />
    <bpmn:exclusiveGateway id="gateway_aceite" name="Usuário Aceitou?" />
    <bpmn:sendTask id="send_rejeicao" name="Enviar Rejeição da Solução" />
    <bpmn:task id="task_aceite_final" name="Registrar Aceite Final" />
    <bpmn:endEvent id="end_sucesso" name="Chamado Encerrado com Sucesso">
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start1_task_send_req" sourceRef="start1" targetRef="task_send_req" />
    <bpmn:sequenceFlow id="Flow_msg_recv_solucao_task_avaliar_solucao" sourceRef="msg_recv_solucao" targetRef="task_avaliar_solucao" />
    <bpmn:sequenceFlow id="Flow_task_avaliar_solucao_gateway_aceite" sourceRef="task_avaliar_solucao" targetRef="gateway_aceite" />
    <bpmn:sequenceFlow id="Flow_gateway_aceite_send_rejeicao" sourceRef="gateway_aceite" targetRef="send_rejeicao" name="Não" />
    <bpmn:sequenceFlow id="Flow_gateway_aceite_task_aceite_final" sourceRef="gateway_aceite" targetRef="task_aceite_final" name="Sim" />
    <bpmn:sequenceFlow id="Flow_task_aceite_final_end_sucesso" sourceRef="task_aceite_final" targetRef="end_sucesso" />
  </bpmn:process>
  <bpmn:process id="Process_lane_sup1" isExecutable="false">
    <bpmn:intermediateCatchEvent id="msg_recv_req" name="Receber Chamado">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="task_analise1" name="Analisar Chamado N1" />
    <bpmn:intermediateCatchEvent id="timer_limite" name="Prazo de 4 Horas">
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="gateway_resolvido" name="Resolvido em 4h?" />
    <bpmn:task id="task_resolvido_n1" name="Registrar Solução Parcial" />
    <bpmn:sendTask id="send_escalar" name="Escalar para Nível 2" />
    <bpmn:sequenceFlow id="Flow_msg_recv_req_task_analise1" sourceRef="msg_recv_req" targetRef="task_analise1" />
    <bpmn:sequenceFlow id="Flow_task_analise1_timer_limite" sourceRef="task_analise1" targetRef="timer_limite" />
    <bpmn:sequenceFlow id="Flow_timer_limite_gateway_resolvido" sourceRef="timer_limite" targetRef="gateway_resolvido" />
    <bpmn:sequenceFlow id="Flow_gateway_resolvido_task_resolvido_n1" sourceRef="gateway_resolvido" targetRef="task_resolvido_n1" name="Sim" />
    <bpmn:sequenceFlow id="Flow_gateway_resolvido_send_escalar" sourceRef="gateway_resolvido" targetRef="send_escalar" name="Não (Timeout)" />
  </bpmn:process>
  <bpmn:process id="Process_lane_sup2" isExecutable="false">
    <bpmn:intermediateCatchEvent id="msg_recv_n2" name="Receber Chamado Escalado">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="task_analise_n2" name="Avaliar Problema N2" />
    <bpmn:exclusiveGateway id="gateway_tipo" name="Problema de Infra?" />
    <bpmn:sendTask id="send_infra" name="Acionar Infraestrutura" />
    <bpmn:intermediateCatchEvent id="msg_recv_infra_resp" name="Receber Resposta Infra">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="task_resolver_n2" name="Finalizar Solução N2" />
    <bpmn:sendTask id="send_solucao_user" name="Enviar Solução ao Usuário" />
    <bpmn:intermediateCatchEvent id="msg_recv_rejeicao" name="Receber Rejeição">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="task_revisar" name="Revisar Chamado Rejeitado" />
    <bpmn:sendTask id="send_nova_solucao" name="Enviar Solução Revisada" />
    <bpmn:sequenceFlow id="Flow_msg_recv_n2_task_analise_n2" sourceRef="msg_recv_n2" targetRef="task_analise_n2" />
    <bpmn:sequenceFlow id="Flow_task_analise_n2_gateway_tipo" sourceRef="task_analise_n2" targetRef="gateway_tipo" />
    <bpmn:sequenceFlow id="Flow_gateway_tipo_send_infra" sourceRef="gateway_tipo" targetRef="send_infra" name="Sim" />
    <bpmn:sequenceFlow id="Flow_msg_recv_infra_resp_task_resolver_n2" sourceRef="msg_recv_infra_resp" targetRef="task_resolver_n2" />
    <bpmn:sequenceFlow id="Flow_gateway_tipo_task_resolver_n2" sourceRef="gateway_tipo" targetRef="task_resolver_n2" name="Não" />
    <bpmn:sequenceFlow id="Flow_task_resolver_n2_send_solucao_user" sourceRef="task_resolver_n2" targetRef="send_solucao_user" />
    <bpmn:sequenceFlow id="Flow_msg_recv_rejeicao_task_revisar" sourceRef="msg_recv_rejeicao" targetRef="task_revisar" />
    <bpmn:sequenceFlow id="Flow_task_revisar_send_nova_solucao" sourceRef="task_revisar" targetRef="send_nova_solucao" />
  </bpmn:process>
  <bpmn:process id="Process_lane_infra" isExecutable="false">
    <bpmn:intermediateCatchEvent id="msg_recv_infra" name="Receber Demanda Infra">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="task_exec_infra" name="Corrigir Problema Infra" />
    <bpmn:sendTask id="send_infra_resp" name="Enviar Resposta Infra" />
    <bpmn:sequenceFlow id="Flow_msg_recv_infra_task_exec_infra" sourceRef="msg_recv_infra" targetRef="task_exec_infra" />
    <bpmn:sequenceFlow id="Flow_task_exec_infra_send_infra_resp" sourceRef="task_exec_infra" targetRef="send_infra_resp" />
  </bpmn:process>
